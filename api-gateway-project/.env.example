# Copy to .env for local development with docker compose. (Render does not
# use this file: render.yaml wires and generates these values itself.)

# Signs and verifies login tokens. Use a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Shared between the gateway and the backend services; the backends reject
# any request that doesn't carry it, so they can't be called around the
# gateway. Also a long random string.
GATEWAY_SECRET=replace-with-another-random-secret

# Redis (rate limiter). The gateway also accepts REDIS_URL, a full
# redis://... connection string, which takes priority if set.
REDIS_ADDR=redis:6379

# Where the gateway finds each backend on the compose network.
USER_SERVICE_URL=http://user-service:3002
ITEM_SERVICE_URL=http://item-service:3001

# Postgres. DATABASE_URL must match the three POSTGRES_* values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=items
DATABASE_URL=postgres://postgres:change-me@postgres:5432/items?sslmode=disable
